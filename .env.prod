DB_USER=demo
DB_PASSWORD=demo
DB_NAME=demo
DB_HOST=db
DB_PORT=5432
# DATABASE_URL is written out in full on purpose: docker compose resolves
# ${...} in an env_file against the project .env (host values), not against
# the neighbouring entries here, which would point the app at 127.0.0.1.
DATABASE_URL="postgres://demo:demo@db:5432/demo"
JWT_SECRET="dEmOsEcReT!1"
ARGON_SECRET="dEmOaRgOnSeCrEt!1"
HOST=0.0.0.0:8000